// Meridian — unified profitability model for Shopify stores.
//
// Design notes that matter:
//  * Money is Decimal, never Float. Cent drift across 6 months of orders is
//    exactly the kind of thing that destroys trust in a profit number.
//  * COGS is snapshotted onto the line item at order time. Supplier costs change;
//    last quarter's profit must not silently change with them.
//  * Per-order profit is materialized. Recomputing a full order history on every
//    dashboard load is not viable, so the engine writes results and any cost-rule
//    change enqueues a recompute.
//  * Cost is effective-dated (`VariantCost`), not a single current number. That
//    is what lets a merchant correct a cost they got wrong in March without
//    either lying about April or silently rewriting a quarter they already
//    reported. Rewriting history is an explicit, audited operation
//    (`PeriodRestatement`) that first freezes what was reported
//    (`PeriodSnapshot`), and it never runs on the request thread (`RecalcJob`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify platform tables
// ---------------------------------------------------------------------------

/// Shape is dictated by @shopify/shopify-app-session-storage-prisma.
///
/// `refreshToken` and `refreshTokenExpires` are not optional extras. Version
/// 9's `sessionToRow` writes both on every `storeSession`, unconditionally —
/// so without these columns Prisma rejects the write with
/// PrismaClientValidationError and no session is ever stored. That is not a
/// degraded mode: it is every install failing at the point it exchanges a
/// token. This schema was copied from a pre-9.x README and the app has never
/// held a session row.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  /// Expiring offline access tokens live an hour; this is what buys a new one.
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

/// Shopify delivers webhooks at-least-once. Recording the delivery id makes
/// replays idempotent instead of double-counting revenue.
model WebhookEvent {
  id               String    @id @default(cuid())
  webhookId        String    @unique
  shopDomain       String
  /// Every retained delivery belongs to a live Shop and cascades with it.
  /// Deliveries for an unknown/already-redacted shop are acknowledged without
  /// retaining a new row.
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  topic            String
  /// Kept only while delivery work is pending. It is set to SQL NULL after a
  /// successful handler. Projected order payloads also have a hard recovery
  /// deadline; mandatory compliance work does not expire by age.
  payload          Json?
  payloadExpiresAt DateTime?
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  error            String?
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now())
  lastAttemptAt    DateTime?
  leaseToken       String?
  leaseExpiresAt   DateTime?

  @@index([shopDomain, topic])
  @@index([shopId])
  @@index([processedAt, availableAt, leaseExpiresAt])
}

// ---------------------------------------------------------------------------
// Store
// ---------------------------------------------------------------------------

model Shop {
  id                 String    @id @default(cuid())
  domain             String    @unique
  name               String
  email              String?
  currency           String    @default("USD")
  timezone           String    @default("America/New_York")
  planName           String?
  /// Shopify's durable development-store signal. Display labels can change
  /// and are not safe input to billing decisions. Null means the signal has
  /// not been read yet, or shop/update invalidated it after a store conversion.
  partnerDevelopment Boolean?
  installedAt        DateTime  @default(now())
  uninstalledAt      DateTime?

  /// Seeded demo store. Never true for a real install.
  isDemo Boolean @default(false)

  lastSyncedAt       DateTime?
  lastComputedAt     DateTime?
  onboardingStep     String    @default("connect_costs")
  fulfillmentSlaDays Int       @default(2)

  // --- historical backfill ---------------------------------------------
  // Webhooks only ever describe what happens next. Without an initial import
  // a freshly installed store has a dashboard full of zeroes, so install
  // kicks off a paginated Admin API backfill and reports its progress here.
  syncStatus         SyncStatus @default(PENDING)
  syncStartedAt      DateTime?
  /// Per-run fencing token. Every progress and terminal write must match it,
  /// so a worker that wakes after lease takeover cannot overwrite the owner.
  syncRunToken       String?
  /// Renewable liveness boundary for detached imports. A missing value is a
  /// legacy run and falls back to syncStartedAt during rolling deployment.
  syncLeaseExpiresAt DateTime?
  syncCompletedAt    DateTime?
  syncStage          String?
  syncedOrders       Int        @default(0)
  syncedProducts     Int        @default(0)
  /// Resume point, so an interrupted import does not start over.
  syncCursor         String?
  syncError          String?

  /// Whether Shopify granted read_all_orders. Without it the Admin API only
  /// returns the last 60 days, and the dashboard must say so rather than
  /// implying the store had no earlier trading.
  hasAllOrdersScope Boolean   @default(false)
  /// Oldest order the import could actually see.
  earliestOrderAt   DateTime?

  /// Scopes the store actually granted at install, as reported by the session.
  /// The import gates its GraphQL fields on these — requesting a field the app
  /// is not authorised for fails the whole query, not just that field.
  grantedScopes String?

  products              Product[]
  variants              Variant[]
  variantCosts          VariantCost[]
  bundleComponents      BundleComponent[]
  periodSnapshots       PeriodSnapshot[]
  periodRestatements    PeriodRestatement[]
  recalcJobs            RecalcJob[]
  orders                Order[]
  lineItems             OrderLineItem[]
  taxComponents         OrderTaxComponent[]
  customers             Customer[]
  adSpend               AdSpend[]
  fulfillments          Fulfillment[]
  shippingCosts         ShippingCostObservation[]
  capacityDays          CapacityDay[]
  costRules             CostRule[]
  connectors            Connector[]
  connectorHealthEvents ConnectorHealthEvent[]
  pricingRecs           PricingRecommendation[]
  priceChanges          PriceChange[]
  dataRequests          DataRequest[]
  customerErasures      CustomerErasure[]
  subscription          Subscription?
  subscriptionEvents    SubscriptionEvent[]
  webhookEvents         WebhookEvent[]
  checkouts             Checkout[]
  usageMeters           UsageMeter[]
  usageMeterEvents      UsageMeterEvent[]
  shippingAdjustments   ShippingLabelAdjustment[]
  adSyncWindows         AdSyncWindow[]
  memberships           ShopMembership[]

  @@index([domain])
}

model Subscription {
  id               String    @id @default(cuid())
  shopId           String    @unique
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan             String    @default("trial")
  /// "monthly" or "annual", derived from the billing key at webhook time.
  /// Without it an annual subscriber's MRR cannot be computed at all.
  interval         String    @default("monthly")
  status           String    @default("active")
  shopifyChargeId  String?
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Every app_subscriptions/update delivery, kept.
///
/// `Subscription` above is current state and is overwritten on every change,
/// which is right for gating but useless for two other jobs: revenue
/// monitoring (MRR over time, churn, trial conversion need history, not
/// state) and auditability (the security audit flagged that plan changes
/// overwrite their own past). This table is append-only — nothing updates or
/// deletes rows except the shop-redact cascade.
model SubscriptionEvent {
  id         String   @id @default(cuid())
  shopId     String
  /// Nullable only for event history written before durable webhook delivery.
  /// Every new row is keyed by Shopify's delivery id so a crash after this
  /// insert cannot append the same plan transition again during recovery.
  webhookId  String?  @unique
  /// Cascade, deliberately: the privacy audit caught WebhookEvent surviving
  /// shop/redact because it had no relation. This table must not repeat that.
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// The subscription name as Shopify sent it — the billing key, so it
  /// carries the interval ("growth-annual") as well as the plan.
  name       String
  plan       String
  interval   String
  status     String
  occurredAt DateTime @default(now())

  @@index([shopId, occurredAt])
  @@index([occurredAt])
}

/// The latest low-cost checkout projection. Checkout webhooks are high volume;
/// keep only the fields Meridian needs for funnel and capacity signals, never
/// the customer's address, phone, or checkout note.
model Checkout {
  id               String    @id @default(cuid())
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  token            String
  cartToken        String?
  currency         String    @default("USD")
  total            Decimal   @default(0) @db.Decimal(12, 2)
  lineCount        Int       @default(0)
  totalQuantity    Int       @default(0)
  status           String    @default("open")
  createdAt        DateTime
  shopifyUpdatedAt DateTime
  completedAt      DateTime?
  receivedAt       DateTime  @default(now())

  @@unique([shopId, token])
  @@index([shopId, shopifyUpdatedAt])
}

/// Aggregate usage for one metric in one billing month. Overage is deliberately
/// soft: Meridian keeps processing the store and only records/communicates the
/// threshold state. Shopify remains the source of truth for any optional usage
/// charge and its capped amount.
model UsageMeter {
  id                   String    @id @default(cuid())
  shopId               String
  shop                 Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  metric               String
  periodStart          DateTime
  periodEnd            DateTime
  used                 Int       @default(0)
  softLimit            Int
  hardLimit            Int
  status               String    @default("under_limit")
  billedUnits          Int       @default(0)
  billingAttempts      Int       @default(0)
  billingError         String?
  lastBillingAttemptAt DateTime?
  lastUsageRecordId    String?
  overageNotifiedAt    DateTime?
  capWarningNotifiedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  events UsageMeterEvent[]

  @@unique([shopId, metric, periodStart])
  @@index([shopId, metric, periodEnd])
  @@index([status, updatedAt])
}

/// One idempotent unit of usage. A Shopify delivery can be replayed and an
/// order can produce both create and update webhooks; sourceId closes both
/// duplicate paths without relying on process memory.
model UsageMeterEvent {
  id        String     @id @default(cuid())
  shopId    String
  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  meterId   String
  meter     UsageMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  source    String
  sourceId  String     @unique
  quantity  Int        @default(1)
  createdAt DateTime   @default(now())

  @@index([meterId, createdAt])
  @@index([shopId, source, createdAt])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id               String    @id @default(cuid())
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyId        String
  title            String
  handle           String
  productType      String?
  vendor           String?
  status           String    @default("ACTIVE")
  imageUrl         String?
  /// Shopify's own product mutation timestamp. This orders webhook and
  /// backfill snapshots independently of the order they reach this process.
  shopifyUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  variants  Variant[]
  lineItems OrderLineItem[]

  @@unique([shopId, shopifyId])
  @@index([shopId, status])
}

model Variant {
  id                     String    @id @default(cuid())
  shopId                 String
  shop                   Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId              String
  product                Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyId              String
  /// Stable Shopify identity behind inventory_items/update deliveries.
  /// Nullable for rows imported before the economic-ingestion migration.
  inventoryItemShopifyId String?
  /// InventoryItem.updatedAt orders cost observations independently of
  /// Product.updatedAt. A cost edit does not necessarily mutate the product.
  inventoryItemUpdatedAt DateTime?
  sku                    String?
  title                  String

  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  /// Current landed unit cost — the denormalised head of `costHistory`, kept
  /// because every catalog read wants today's number and none of them want a
  /// timeline. Historical orders use their own snapshot.
  unitCost   Decimal?   @db.Decimal(12, 4)
  costSource CostSource @default(SHOPIFY)

  weightGrams  Int?
  inventoryQty Int  @default(0)

  lineItems    OrderLineItem[]
  priceHistory PriceChange[]
  costHistory  VariantCost[]
  pricingRecs  PricingRecommendation[]

  /// Edges where this variant is the multi-pack, and where it is the unit.
  bundleComponents BundleComponent[] @relation("BundleParent")
  bundledInto      BundleComponent[] @relation("BundleMemberOf")

  @@unique([shopId, shopifyId])
  @@unique([shopId, inventoryItemShopifyId])
  @@index([shopId])
  @@index([productId])
}

/// Effective-dated landed unit cost — the cost timeline behind `Variant.unitCost`.
///
/// `Variant.unitCost` answers "what does this cost today". It cannot answer
/// "what did it cost in March", and that second question is the whole of
/// historical profit. Snapshotting onto the line item preserved March, but it
/// also made March unfixable: a merchant who imported a wrong cost, or who only
/// learned the freight component a month later, had no way to correct the past
/// short of editing the database.
///
/// So cost is a timeline. Each row means "from this instant, this variant cost
/// this much", and it is open-ended until the next row supersedes it. A
/// correction to the past is a row with a past `effectiveAt`, which is a
/// different act from raising a price today, and the two must not be confused —
/// which is exactly what a single mutable column forced them to be.
///
/// Writing a row changes no reported number by itself. Restating history is the
/// separate, audited operation in `PeriodRestatement`.
model VariantCost {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  unitCost Decimal    @db.Decimal(12, 4)
  source   CostSource @default(MANUAL)

  /// The instant this cost became true of the world — a supplier invoice date,
  /// not the moment Meridian was told. Backdating is the point of the table.
  effectiveAt DateTime
  /// When Meridian learned it. `effectiveAt` orders the timeline; this orders
  /// the audit trail, and the gap between them is what a correction looks like.
  recordedAt  DateTime @default(now())

  /// Free text from the merchant ("Q2 freight increase"), surfaced in history.
  note String?

  @@unique([variantId, effectiveAt])
  @@index([shopId, effectiveAt])
  @@index([variantId, effectiveAt])
}

/// One edge of the bundle graph: a bundle variant contains N of a component.
///
/// A 3-pack is not a product with its own cost — it is three of something else,
/// and a store that sells both cannot keep the two costs honest by hand. When
/// the single unit's cost moves, every multi-pack containing it is wrong until
/// someone remembers. This table is what lets the rollup remember instead.
///
/// A detected mapping is a proposal, not a fact. `confirmedAt` is null until a
/// merchant agrees, and the rollup ignores unconfirmed edges: inferring from a
/// SKU suffix that a product's COGS should triple, and then silently doing it,
/// is precisely the kind of unasked-for accounting that makes a profit number
/// untrustworthy.
model BundleComponent {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  bundleVariantId String
  bundleVariant   Variant @relation("BundleParent", fields: [bundleVariantId], references: [id], onDelete: Cascade)

  componentVariantId String
  componentVariant   Variant @relation("BundleMemberOf", fields: [componentVariantId], references: [id], onDelete: Cascade)

  /// Units of the component in one bundle. Always at least 1.
  quantity Int

  source   BundleSource @default(MANUAL)
  /// The evidence for an inferred edge — the SKU or title fragment that matched.
  /// Kept so a merchant reviewing a proposal can see why it was proposed.
  evidence String?

  /// Null means proposed but not agreed. The rollup reads confirmed edges only.
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bundleVariantId, componentVariantId])
  @@index([shopId, bundleVariantId])
  @@index([shopId, componentVariantId])
  @@index([shopId, confirmedAt])
}

/// What a calendar month was reported to say, frozen before anything rewrites it.
///
/// Restating history is useful and dangerous in the same breath. A merchant who
/// filed taxes, paid a partner, or briefed an investor on March's margin needs
/// March's *correction* to be visible as a correction — not to find that the
/// number they quoted no longer exists anywhere.
///
/// So the first act of any restatement is to freeze the affected months here if
/// they are not frozen already. These figures are as-reported and never change
/// again; the live tables carry the restated truth, and `PeriodRestatement`
/// carries the difference. A CLOSED period additionally refuses restatement
/// unless the operation explicitly names it.
model PeriodSnapshot {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  /// Merchant-local calendar month, "YYYY-MM" — the same key the engine buckets
  /// overhead by, so a snapshot boundary is an engine boundary.
  periodKey String
  status    PeriodStatus @default(OPEN)

  orderCount         Int
  units              Int
  netRevenue         Decimal @db.Decimal(14, 2)
  cogs               Decimal @db.Decimal(14, 2)
  contributionProfit Decimal @db.Decimal(14, 2)
  netProfit          Decimal @db.Decimal(14, 2)

  capturedAt DateTime  @default(now())
  closedAt   DateTime?

  /// How many restatements have moved this period away from its frozen figures.
  restatementCount Int @default(0)

  restatements PeriodRestatement[]

  @@unique([shopId, periodKey])
  @@index([shopId, status])
}

/// Append-only record of one restatement's effect on one period.
///
/// Nothing updates or deletes these rows except the shop cascade. Together with
/// the snapshot they answer the only question that matters after a correction:
/// what did this month say before, what does it say now, and why.
model PeriodRestatement {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  snapshotId String
  snapshot   PeriodSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  /// The job that applied it. SetNull, not Cascade: pruning finished job rows
  /// must never quietly delete the accounting trail they produced.
  jobId String?
  job   RecalcJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  periodKey String
  reason    String

  ordersAffected    Int
  lineItemsAffected Int

  cogsBefore               Decimal @db.Decimal(14, 2)
  cogsAfter                Decimal @db.Decimal(14, 2)
  contributionProfitBefore Decimal @db.Decimal(14, 2)
  contributionProfitAfter  Decimal @db.Decimal(14, 2)
  netProfitBefore          Decimal @db.Decimal(14, 2)
  netProfitAfter           Decimal @db.Decimal(14, 2)

  appliedAt DateTime @default(now())

  @@index([shopId, periodKey, appliedAt])
  @@index([snapshotId])
  @@index([jobId])
}

/// Durable queue for work that must not run on a request thread.
///
/// A restatement rewrites line items across months and then recomputes the whole
/// shop. That is minutes of work on a large store, so it cannot be an `await` in
/// a form action, and it cannot be an in-process promise either: a Fly deploy
/// mid-restatement would leave half a quarter rewritten with nothing recording
/// that it had started.
///
/// The lease columns mirror `WebhookEvent` deliberately — same claim, same
/// backoff, same recovery loop shape — so there is one durable-work pattern in
/// this codebase to reason about rather than two.
model RecalcJob {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  kind   RecalcJobKind
  status RecalcJobStatus @default(QUEUED)

  /// Collapses duplicate enqueues of identical outstanding work — a merchant
  /// editing six costs in a minute wants one restatement, not six. Cleared when
  /// the job leaves the queue so the same work can legitimately be asked for
  /// again later.
  dedupeKey String? @unique

  payload Json
  result  Json?

  attempts    Int      @default(0)
  availableAt DateTime @default(now())

  leaseToken     String?
  leaseExpiresAt DateTime?

  startedAt  DateTime?
  finishedAt DateTime?
  error      String?

  createdAt DateTime @default(now())

  restatements PeriodRestatement[]

  @@index([status, availableAt, leaseExpiresAt])
  @@index([shopId, kind, createdAt])
  @@index([shopId, status])
}

/// Price history is what makes real elasticity estimation possible. Without
/// observed price variation, the pricing engine has to say so rather than guess.
model PriceChange {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price       Decimal  @db.Decimal(12, 2)
  effectiveAt DateTime

  @@index([variantId, effectiveAt])
}

// ---------------------------------------------------------------------------
// Customers & orders
// ---------------------------------------------------------------------------

model Customer {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyId String
  email     String?

  firstOrderAt          DateTime?
  acquisitionChannel    Channel   @default(DIRECT)
  acquisitionCampaignId String?

  ordersCount     Int     @default(0)
  lifetimeRevenue Decimal @default(0) @db.Decimal(14, 2)
  lifetimeProfit  Decimal @default(0) @db.Decimal(14, 2)

  orders Order[]

  @@unique([shopId, shopifyId])
  @@index([shopId, acquisitionChannel])
  @@index([shopId, firstOrderAt])
}

/// A secret-keyed, one-way guard against recreating a shopper after
/// customers/redact.
///
/// Webhooks and the historical import race compliance delivery in ordinary
/// operation. Deleting Customer alone is therefore insufficient: an already
/// running order write, a queued delivery, or a later backfill can upsert the
/// same Shopify customer again. Both identifier hashes are scoped to the Shop;
/// no raw customer id or email is retained here.
model CustomerErasure {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  identifierHash String
  createdAt      DateTime @default(now())

  @@unique([shopId, identifierHash])
  @@index([shopId, createdAt])
}

/// A serviced `customers/data_request`, held for the merchant to collect.
///
/// Shopify makes the merchant the controller and gives them 30 days to answer
/// the shopper; the app is a processor and must hand the export to the merchant
/// rather than to the customer. Assembling the report and dropping it — which is
/// what this app did before this table existed — leaves the merchant with no way
/// to answer, while Settings and the privacy policy both promise they can.
model DataRequest {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  /// Shopify's delivery id. Unique, so a retried webhook updates the one export
  /// instead of stacking copies of the same customer's data.
  webhookId String @unique

  /// Normally as Shopify sent it, so `customers/redact` can find this row
  /// without depending on a Customer row that redaction is about to delete.
  /// A request serviced after erasure uses the fixed value "redacted-request"
  /// instead, so answering it does not retain the supplied customer id again.
  shopifyCustomerId String
  customerEmail     String?

  requestedAt    DateTime @default(now())
  ordersIncluded Int      @default(0)

  /// The assembled export, exactly as the merchant will receive it.
  report Json

  collectedAt DateTime?

  /// An export is a second copy of a shopper's data, so it does not live
  /// forever: it is deleted at this point whether or not it was collected.
  expiresAt DateTime

  @@index([shopId, requestedAt])
  @@index([shopId, shopifyCustomerId])
}

model Order {
  id               String    @id @default(cuid())
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyId        String
  /// Shopify's source mutation time. Delivery time is not chronology: webhook
  /// retries and the historical import can arrive after a newer snapshot.
  shopifyUpdatedAt DateTime?
  orderNumber      Int
  processedAt      DateTime

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  currency        String    @default("USD")
  subtotal        Decimal   @db.Decimal(12, 2)
  discountTotal   Decimal   @default(0) @db.Decimal(12, 2)
  shippingCharged Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal   @default(0) @db.Decimal(12, 2)
  /// Whether Shopify's merchandise and shipping prices already include tax.
  taxesIncluded   Boolean   @default(false)
  /// Country/region only. Meridian never needs or stores the street address to
  /// classify a tax line as VAT versus a US state/local component.
  taxCountryCode  String?   @db.VarChar(2)
  taxRegionCode   String?   @db.VarChar(16)
  taxReconciledAt DateTime?
  total           Decimal   @db.Decimal(12, 2)
  refundedTotal   Decimal   @default(0) @db.Decimal(12, 2)

  /// Customer-facing currency on a multi-currency order. Monetary ledger
  /// columns remain shop currency; these fields retain Shopify's conversion
  /// evidence for refunds and reconciliation.
  presentmentCurrency     String?
  presentmentTotal        Decimal? @db.Decimal(12, 2)
  presentmentExchangeRate Decimal? @db.Decimal(20, 10)
  returnFeesRetained      Decimal  @default(0) @db.Decimal(12, 2)

  financialStatus   String @default("paid")
  fulfillmentStatus String @default("unfulfilled")

  channel      Channel @default(DIRECT)
  campaignId   String?
  campaignName String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  landingSite  String?
  isFirstOrder Boolean @default(false)

  // --- materialized by the profit engine ---
  cogsTotal          Decimal   @default(0) @db.Decimal(12, 2)
  shippingCost       Decimal   @default(0) @db.Decimal(12, 2)
  paymentFee         Decimal   @default(0) @db.Decimal(12, 2)
  adCostAttributed   Decimal   @default(0) @db.Decimal(12, 2)
  overheadAllocated  Decimal   @default(0) @db.Decimal(12, 2)
  contributionProfit Decimal   @default(0) @db.Decimal(12, 2)
  netProfit          Decimal   @default(0) @db.Decimal(12, 2)
  computedAt         DateTime?

  lineItems                OrderLineItem[]
  fulfillments             Fulfillment[]
  taxComponents            OrderTaxComponent[]
  shippingCostObservations ShippingCostObservation[]
  shippingAdjustments      ShippingLabelAdjustment[]

  @@unique([shopId, shopifyId])
  @@index([shopId, processedAt])
  @@index([shopId, channel, processedAt])
  @@index([shopId, netProfit])
  @@index([customerId])
}

/// Shopify is the tax calculator of record. Meridian stores how its reported
/// order total splits by jurisdiction, without inventing a second tax engine.
model OrderTaxComponent {
  id      String @id @default(cuid())
  shopId  String
  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sourceKey          String
  regime             TaxRegime
  jurisdictionType   TaxJurisdictionType
  title              String
  source             String?
  countryCode        String?             @db.VarChar(2)
  regionCode         String?             @db.VarChar(16)
  rate               Decimal?            @db.Decimal(12, 8)
  taxableAmount      Decimal             @default(0) @db.Decimal(24, 2)
  reportedTax        Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal             @default(0) @db.Decimal(12, 2)
  lineItemTax        Decimal             @default(0) @db.Decimal(12, 2)
  shippingTax        Decimal             @default(0) @db.Decimal(12, 2)
  roundingAdjustment Decimal             @default(0) @db.Decimal(12, 2)
  channelLiable      Boolean?
  includedInPrice    Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([orderId, sourceKey])
  @@index([shopId, regime, jurisdictionType])
}

/// An immutable carrier or merchant correction to shipping cost. It is kept
/// separate from a provider's original ShippingCostObservation so invoice
/// replays stay idempotent and a correction never rewrites history.
model ShippingLabelAdjustment {
  id            String       @id @default(cuid())
  shopId        String
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillmentId String?
  fulfillment   Fulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)

  kind           ShippingAdjustmentKind
  source         ShippingAdjustmentSource
  reference      String
  amount         Decimal                  @db.Decimal(12, 2)
  sourceCurrency String?
  sourceAmount   Decimal?                 @db.Decimal(12, 2)
  reason         String?
  occurredAt     DateTime
  createdAt      DateTime                 @default(now())

  @@unique([shopId, source, reference])
  @@index([orderId])
  @@index([shopId, occurredAt])
}

model OrderLineItem {
  id        String @id @default(cuid())
  shopId    String
  shop      Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyId String

  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  title    String
  sku      String?
  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)

  /// COGS as it was on the day this order was placed.
  unitCost    Decimal @default(0) @db.Decimal(12, 4)
  refundedQty Int     @default(0)

  /// Which `VariantCost.effectiveAt` this snapshot came from. Null means the
  /// line predates cost history and was frozen from `Variant.unitCost` — the
  /// distinction matters, because only the former can be re-derived and checked.
  costEffectiveAt DateTime?
  /// Set when a restatement rewrote `unitCost` above. Its presence is why a
  /// line's COGS may differ from what the order originally reported, and the
  /// matching `PeriodRestatement` says by how much and why.
  costRestatedAt  DateTime?

  /// Line items are deleted and recreated on every order sync, outside a
  /// transaction. Two concurrent deliveries of the same order could interleave
  /// into two copies of each line, which would double both COGS and units for
  /// that order and be invisible in the totals. The database is the only place
  /// this can be closed cheaply.
  @@unique([orderId, shopifyId])
  @@index([orderId])
  @@index([shopId, productId])
  @@index([shopId, variantId])
}

// ---------------------------------------------------------------------------
// Marketing spend
// ---------------------------------------------------------------------------

model AdSpend {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  channel      Channel
  campaignId   String?
  campaignName String?

  spend       Decimal @default(0) @db.Decimal(12, 2)
  impressions Int     @default(0)
  clicks      Int     @default(0)

  /// What the ad platform claims it drove. Kept separate from Meridian's own
  /// attribution so the dashboard can show the gap — that gap is the product.
  platformConversions Int     @default(0)
  platformRevenue     Decimal @default(0) @db.Decimal(12, 2)

  @@unique([shopId, date, channel, campaignId])
  @@index([shopId, date])
  @@index([shopId, channel, date])
}

// ---------------------------------------------------------------------------
// Fulfillment
// ---------------------------------------------------------------------------

model Fulfillment {
  id      String @id @default(cuid())
  shopId  String
  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Shopify's own fulfilment id. The only stable identity a `fulfillments/update`
  /// carries: it repeats the original `created_at`, so matching on time alone
  /// mistook every update for a duplicate and dropped it. Nullable because rows
  /// imported before this column existed have no id to backfill — Postgres treats
  /// NULLs as distinct, so those legacy rows do not collide with each other.
  shopifyId        String?
  /// Shopify's source mutation time, used to keep delayed pre-cancellation
  /// deliveries from resurrecting a shipment and warehouse capacity.
  shopifyUpdatedAt DateTime?

  status       String    @default("pending")
  createdAt    DateTime
  shippedAt    DateTime?
  deliveredAt  DateTime?
  carrier      String?
  serviceLevel String?

  shippingCost Decimal @default(0) @db.Decimal(12, 2)
  pickPackCost Decimal @default(0) @db.Decimal(12, 2)
  itemCount    Int     @default(0)
  location     String  @default("primary")

  shippingCostObservations ShippingCostObservation[]
  labelAdjustments         ShippingLabelAdjustment[]

  @@unique([shopId, shopifyId])
  @@index([shopId, createdAt])
  @@index([orderId])
}

/// One immutable-looking source record from ShipStation or Shopify Shipping.
/// Upserts follow the provider's stable id so API retries cannot double cost.
model ShippingCostObservation {
  id            String       @id @default(cuid())
  shopId        String
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillmentId String?
  fulfillment   Fulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)

  source            ShippingCostSource
  externalId        String
  externalOrderRef  String?
  carrier           String?
  serviceLevel      String?
  currency          String                    @db.VarChar(3)
  amount            Decimal                   @db.Decimal(12, 2)
  labelCount        Int                       @default(1)
  observedAt        DateTime
  sourceUpdatedAt   DateTime?
  status            ShippingObservationStatus @default(UNMATCHED)
  discrepancyReason String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([shopId, source, externalId])
  @@index([shopId, status, observedAt])
  @@index([orderId, source])
}

/// Daily warehouse throughput. Backlog and capacity alerts are derived from
/// observed fulfilment rate, not from a number the merchant typed in once.
model CapacityDay {
  id       String   @id @default(cuid())
  shopId   String
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  location String   @default("primary")

  ordersReceived   Int     @default(0)
  ordersFulfilled  Int     @default(0)
  unitsFulfilled   Int     @default(0)
  backlogEnd       Int     @default(0)
  staffedHours     Decimal @default(0) @db.Decimal(8, 2)
  maxDailyCapacity Int     @default(0)

  @@unique([shopId, date, location])
  @@index([shopId, date])
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

model CostRule {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  kind  CostRuleKind
  label String

  /// Effective cost = percentRate * revenue
  ///                + fixedPerOrder
  ///                + fixedPerItem * units
  ///                + monthlyAmount amortised across that month's orders
  percentRate   Decimal? @db.Decimal(8, 5)
  fixedPerOrder Decimal? @db.Decimal(12, 4)
  fixedPerItem  Decimal? @db.Decimal(12, 4)
  monthlyAmount Decimal? @db.Decimal(12, 2)

  appliesToChannel Channel?
  active           Boolean        @default(true)
  /// Where this rule first came from. Confirmation is separate: a merchant can
  /// review an install default without erasing the fact that it began as one.
  origin           CostRuleOrigin @default(MERCHANT_CONFIGURED)
  /// Null means Meridian has no durable evidence that a merchant reviewed the
  /// current assumption. A successful Settings save stamps this field.
  confirmedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([shopId, kind, active])
}

model Connector {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  provider ConnectorProvider
  status   ConnectorStatus   @default(NOT_CONFIGURED)

  externalAccountId String?
  displayName       String?

  /// AES-256-GCM ciphertext. See app/lib/crypto.server.ts — never plaintext.
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?

  /// Optional independently-issued credential promoted only after the primary
  /// cannot be refreshed and a live probe proves it unusable.
  standbyAccessTokenEnc  String?
  standbyRefreshTokenEnc String?
  standbyTokenExpiresAt  DateTime?

  lastSyncedAt        DateTime?
  lastError           String?
  healthStatus        ConnectorHealthStatus @default(UNKNOWN)
  lastHealthCheckedAt DateTime?
  lastHealthyAt       DateTime?
  nextHealthCheckAt   DateTime?
  consecutiveFailures Int                   @default(0)
  failoverCount       Int                   @default(0)

  /// ShipStation v2 supports custom webhook headers. The provider id is not a
  /// credential; the listener secret remains AES-GCM ciphertext.
  webhookId           String?
  webhookSecretEnc    String?
  webhookRegisteredAt DateTime?

  /// Cross-process ownership for scheduled provider work. In-memory guards
  /// alone do not prevent duplicate probes, failovers or alerts on two VMs.
  workLeaseToken     String?
  workLeaseExpiresAt DateTime?

  healthEvents    ConnectorHealthEvent[]
  accountCurrency String?
  /// Watermark for the weekly full attribution-window restatement poll.
  lastDeepSyncAt  DateTime?
  syncWindows     AdSyncWindow[]

  @@unique([shopId, provider])
  @@index([workLeaseExpiresAt])
}

model ConnectorHealthEvent {
  id          String                   @id @default(cuid())
  shopId      String
  shop        Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  connectorId String
  connector   Connector                @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  provider    ConnectorProvider
  kind        ConnectorHealthEventKind
  status      ConnectorHealthStatus
  message     String
  attempt     Int                      @default(1)
  notifiedAt  DateTime?
  createdAt   DateTime                 @default(now())

  @@index([shopId, createdAt])
  @@index([connectorId, createdAt])
}

/// Durable per-connector/day ad sync ledger. Redis schedules work, while this
/// table makes missing and restated days recoverable after a worker restart.
model AdSyncWindow {
  id            String            @id @default(cuid())
  shopId        String
  shop          Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  connectorId   String
  connector     Connector         @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  day           DateTime          @db.Date
  status        AdSyncWindowState @default(PENDING)
  attempts      Int               @default(0)
  rowsWritten   Int               @default(0)
  contentHash   String?
  lastChangedAt DateTime?
  lastError     String?
  syncedAt      DateTime?
  updatedAt     DateTime          @updatedAt

  @@unique([connectorId, day])
  @@index([shopId, status, day])
}

/// Immutable daily FX rate used for ad and carrier-cost conversion.
model ExchangeRate {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  base      String
  quote     String
  rate      Decimal  @db.Decimal(20, 10)
  source    String   @default("frankfurter")
  fetchedAt DateTime @default(now())

  @@unique([day, base, quote])
  @@index([base, quote, day])
}

model PricingRecommendation {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  currentPrice   Decimal @db.Decimal(12, 2)
  suggestedPrice Decimal @db.Decimal(12, 2)

  expectedUnitsDeltaPct Decimal @default(0) @db.Decimal(8, 4)
  expectedProfitDelta   Decimal @default(0) @db.Decimal(12, 2)

  elasticity Decimal?   @db.Decimal(8, 4)
  confidence Confidence @default(LOW)
  method     String
  rationale  String     @db.Text

  status      RecStatus @default(PENDING)
  generatedAt DateTime  @default(now())
  actionedAt  DateTime?

  @@index([shopId, status, generatedAt])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Web accounts
// ---------------------------------------------------------------------------
//
// Everything above this line is keyed by Shop, because the embedded app learns
// who you are from Shopify's session token and never needs an identity of its
// own. The web dashboard has no such token, so it needs one.
//
// The rule these tables exist to enforce: signing up proves you own an email
// address, and nothing else. It does not prove you control a store. Only the
// Shopify OAuth install does that, so `ShopMembership` is written from the
// OAuth callback and never from a signup form — otherwise anyone who typed a
// merchant's address would be handed that merchant's revenue.

/// A person, as opposed to a store. Sign-in methods hang off this.
model User {
  id    String  @id @default(cuid())
  /// Lowercased and trimmed before write; the uniqueness guarantee is only
  /// meaningful if "A@x.com" and "a@x.com" cannot both exist.
  email String  @unique
  name  String?

  /// Null for accounts that only ever signed in with Apple or Google. Such an
  /// account has no password to guess, so the absence is a feature; the login
  /// form must still not reveal which kind of account an address belongs to.
  passwordHash String?

  emailVerifiedAt DateTime?

  /// Gate for the one-time post-signup splash. A timestamp rather than a
  /// boolean so it also answers "when did this account start", and so the
  /// splash cannot be replayed by a second device or a re-login.
  welcomedAt DateTime?

  /// Throttling state for password attempts. Kept on the row rather than in
  /// memory so it survives a deploy and is shared across every Fly machine —
  /// an in-process counter resets exactly when an attacker wants it to.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts      OAuthAccount[]
  sessions           WebSession[]
  memberships        ShopMembership[]
  verificationTokens EmailVerificationToken[]

  @@index([email])
}

/// A third-party sign-in method bound to a User.
model OAuthAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider AuthProvider
  /// The provider's stable subject claim (`sub`), never the email. Apple lets
  /// a user hide their address and rotates the relay, and Google addresses can
  /// be reassigned within a workspace; keying on email would silently merge or
  /// orphan accounts.
  providerUserId String
  /// Whatever address the provider released, kept for display only.
  providerEmail String?

  createdAt DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// A logged-in browser.
model WebSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the cookie value, never the value itself. A dump of this table
  /// must not be enough to log in as anyone.
  tokenHash String @unique

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Recorded so a user can recognise a session when revoking it.
  userAgent String?

  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// Proof that a User controls a Shop.
///
/// Written only after a Shopify OAuth install completes for a shop while that
/// user was signed in. This is the join that decides whose numbers a web
/// session is allowed to see, so it is the security boundary of the whole web
/// dashboard.
model ShopMembership {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now())

  @@unique([userId, shopId])
  @@index([shopId])
}

/// A single-use email-confirmation token.
///
/// Hashed like a session token, for the same reason. Rows are kept after use
/// so a consumed token is rejected as consumed rather than as unknown.
model EmailVerificationToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AuthProvider {
  GOOGLE
  APPLE
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum Channel {
  FACEBOOK
  GOOGLE
  TIKTOK
  EMAIL
  ORGANIC_SEARCH
  DIRECT
  REFERRAL
  AFFILIATE
  OTHER
}

enum CostSource {
  SHOPIFY
  MANUAL
  ESTIMATED
  /// Derived by summing a bundle's components. Never merchant-entered: the
  /// rollup owns these rows and overwrites them when a component cost moves.
  BUNDLE_ROLLUP
}

/// How a bundle's component mapping was established.
enum BundleSource {
  /// The merchant drew the mapping themselves.
  MANUAL
  /// Inferred from a multi-pack SKU convention ("WIDGET-BLU-3PK").
  SKU_PATTERN
  /// Inferred from a multi-pack phrase in the variant or product title.
  TITLE_PATTERN
  /// Shopify's own bundle component relationship.
  SHOPIFY_BUNDLE
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum RecalcJobKind {
  COST_RESTATEMENT
  BUNDLE_ROLLUP
  BUNDLE_DETECTION
}

enum RecalcJobStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum CostRuleKind {
  PAYMENT_FEE
  SHIPPING_DEFAULT
  PICK_PACK
  OVERHEAD_MONTHLY
  CUSTOM
}

enum CostRuleOrigin {
  INSTALL_DEFAULT
  MERCHANT_CONFIGURED
  DEMO_SEED
  LEGACY_UNKNOWN
}

enum ConnectorProvider {
  SHOPIFY
  FACEBOOK_ADS
  GOOGLE_ADS
  TIKTOK_ADS
  STRIPE
  WAREHOUSE_3PL
  SHIPSTATION
  SHOPIFY_SHIPPING
}

enum ConnectorStatus {
  NOT_CONFIGURED
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ConnectorHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
}

enum ConnectorHealthEventKind {
  CHECK_PASSED
  CHECK_FAILED
  TOKEN_REFRESHED
  FAILOVER_ACTIVATED
  ALERT_SENT
  ALERT_FAILED
}

enum TaxRegime {
  EU_VAT
  US_SALES_TAX
  GST
  OTHER
  UNALLOCATED
}

enum TaxJurisdictionType {
  VAT
  STATE
  COUNTY
  CITY
  DISTRICT
  NATIONAL
  OTHER
  UNALLOCATED
}

enum ShippingCostSource {
  SHIPSTATION
  SHOPIFY_SHIPPING
}

enum ShippingObservationStatus {
  MATCHED
  UNMATCHED
  CURRENCY_MISMATCH
  CONFLICT
  VOIDED
}

enum ShippingAdjustmentKind {
  LABEL_PURCHASE
  CARRIER_ADJUSTMENT
  RETURN_LABEL
}

enum ShippingAdjustmentSource {
  SHOPIFY
  CARRIER_INVOICE
  THREEPL
  MANUAL
}

enum AdSyncWindowState {
  PENDING
  SYNCED
  FAILED
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum RecStatus {
  PENDING
  APPLIED
  DISMISSED
}
