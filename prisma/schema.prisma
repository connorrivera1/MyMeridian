// Meridian — unified profitability model for Shopify stores.
//
// Design notes that matter:
//  * Money is Decimal, never Float. Cent drift across 6 months of orders is
//    exactly the kind of thing that destroys trust in a profit number.
//  * COGS is snapshotted onto the line item at order time. Supplier costs change;
//    last quarter's profit must not silently change with them.
//  * Per-order profit is materialized. Recomputing a full order history on every
//    dashboard load is not viable, so the engine writes results and any cost-rule
//    change enqueues a recompute.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify platform tables
// ---------------------------------------------------------------------------

/// Shape is dictated by @shopify/shopify-app-session-storage-prisma.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@index([shop])
}

/// Shopify delivers webhooks at-least-once. Recording the delivery id makes
/// replays idempotent instead of double-counting revenue.
model WebhookEvent {
  id          String    @id @default(cuid())
  webhookId   String    @unique
  shopDomain  String
  topic       String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([shopDomain, topic])
}

// ---------------------------------------------------------------------------
// Store
// ---------------------------------------------------------------------------

model Shop {
  id            String    @id @default(cuid())
  domain        String    @unique
  name          String
  email         String?
  currency      String    @default("USD")
  timezone      String    @default("America/New_York")
  planName      String?
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?

  /// Seeded demo store. Never true for a real install.
  isDemo Boolean @default(false)

  lastSyncedAt      DateTime?
  lastComputedAt    DateTime?
  onboardingStep    String    @default("connect_costs")
  fulfillmentSlaDays Int      @default(2)

  // --- historical backfill ---------------------------------------------
  // Webhooks only ever describe what happens next. Without an initial import
  // a freshly installed store has a dashboard full of zeroes, so install
  // kicks off a paginated Admin API backfill and reports its progress here.
  syncStatus      SyncStatus @default(PENDING)
  syncStartedAt   DateTime?
  syncCompletedAt DateTime?
  syncStage       String?
  syncedOrders    Int        @default(0)
  syncedProducts  Int        @default(0)
  /// Resume point, so an interrupted import does not start over.
  syncCursor      String?
  syncError       String?

  /// Whether Shopify granted read_all_orders. Without it the Admin API only
  /// returns the last 60 days, and the dashboard must say so rather than
  /// implying the store had no earlier trading.
  hasAllOrdersScope Boolean  @default(false)
  /// Oldest order the import could actually see.
  earliestOrderAt   DateTime?

  /// Scopes the store actually granted at install, as reported by the session.
  /// The import gates its GraphQL fields on these — requesting a field the app
  /// is not authorised for fails the whole query, not just that field.
  grantedScopes     String?

  products     Product[]
  variants     Variant[]
  orders       Order[]
  lineItems    OrderLineItem[]
  customers    Customer[]
  adSpend      AdSpend[]
  fulfillments Fulfillment[]
  capacityDays CapacityDay[]
  costRules    CostRule[]
  connectors   Connector[]
  pricingRecs  PricingRecommendation[]
  priceChanges PriceChange[]
  subscription Subscription?

  @@index([domain])
}

model Subscription {
  id               String    @id @default(cuid())
  shopId           String    @unique
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan             String    @default("trial")
  status           String    @default("active")
  shopifyChargeId  String?
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyId   String
  title       String
  handle      String
  productType String?
  vendor      String?
  status      String   @default("ACTIVE")
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants  Variant[]
  lineItems OrderLineItem[]

  @@unique([shopId, shopifyId])
  @@index([shopId, status])
}

model Variant {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyId String
  sku       String?
  title     String

  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  /// Current landed unit cost. Historical orders use their own snapshot.
  unitCost   Decimal?   @db.Decimal(12, 4)
  costSource CostSource @default(SHOPIFY)

  weightGrams  Int?
  inventoryQty Int @default(0)

  lineItems    OrderLineItem[]
  priceHistory PriceChange[]
  pricingRecs  PricingRecommendation[]

  @@unique([shopId, shopifyId])
  @@index([shopId])
  @@index([productId])
}

/// Price history is what makes real elasticity estimation possible. Without
/// observed price variation, the pricing engine has to say so rather than guess.
model PriceChange {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price       Decimal  @db.Decimal(12, 2)
  effectiveAt DateTime

  @@index([variantId, effectiveAt])
}

// ---------------------------------------------------------------------------
// Customers & orders
// ---------------------------------------------------------------------------

model Customer {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyId String
  email     String?

  firstOrderAt          DateTime?
  acquisitionChannel    Channel   @default(DIRECT)
  acquisitionCampaignId String?

  ordersCount     Int     @default(0)
  lifetimeRevenue Decimal @db.Decimal(14, 2) @default(0)
  lifetimeProfit  Decimal @db.Decimal(14, 2) @default(0)

  orders Order[]

  @@unique([shopId, shopifyId])
  @@index([shopId, acquisitionChannel])
  @@index([shopId, firstOrderAt])
}

model Order {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyId   String
  orderNumber Int
  processedAt DateTime

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  currency        String  @default("USD")
  subtotal        Decimal @db.Decimal(12, 2)
  discountTotal   Decimal @db.Decimal(12, 2) @default(0)
  shippingCharged Decimal @db.Decimal(12, 2) @default(0)
  taxTotal        Decimal @db.Decimal(12, 2) @default(0)
  total           Decimal @db.Decimal(12, 2)
  refundedTotal   Decimal @db.Decimal(12, 2) @default(0)

  financialStatus   String @default("paid")
  fulfillmentStatus String @default("unfulfilled")

  channel      Channel @default(DIRECT)
  campaignId   String?
  campaignName String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  landingSite  String?
  isFirstOrder Boolean @default(false)

  // --- materialized by the profit engine ---
  cogsTotal          Decimal   @db.Decimal(12, 2) @default(0)
  shippingCost       Decimal   @db.Decimal(12, 2) @default(0)
  paymentFee         Decimal   @db.Decimal(12, 2) @default(0)
  adCostAttributed   Decimal   @db.Decimal(12, 2) @default(0)
  overheadAllocated  Decimal   @db.Decimal(12, 2) @default(0)
  contributionProfit Decimal   @db.Decimal(12, 2) @default(0)
  netProfit          Decimal   @db.Decimal(12, 2) @default(0)
  computedAt         DateTime?

  lineItems    OrderLineItem[]
  fulfillments Fulfillment[]

  @@unique([shopId, shopifyId])
  @@index([shopId, processedAt])
  @@index([shopId, channel, processedAt])
  @@index([shopId, netProfit])
  @@index([customerId])
}

model OrderLineItem {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyId String

  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  title    String
  sku      String?
  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @db.Decimal(12, 2) @default(0)

  /// COGS as it was on the day this order was placed.
  unitCost    Decimal @db.Decimal(12, 4) @default(0)
  refundedQty Int     @default(0)

  @@index([orderId])
  @@index([shopId, productId])
  @@index([shopId, variantId])
}

// ---------------------------------------------------------------------------
// Marketing spend
// ---------------------------------------------------------------------------

model AdSpend {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  channel      Channel
  campaignId   String?
  campaignName String?

  spend       Decimal @db.Decimal(12, 2) @default(0)
  impressions Int     @default(0)
  clicks      Int     @default(0)

  /// What the ad platform claims it drove. Kept separate from Meridian's own
  /// attribution so the dashboard can show the gap — that gap is the product.
  platformConversions Int     @default(0)
  platformRevenue     Decimal @db.Decimal(12, 2) @default(0)

  @@unique([shopId, date, channel, campaignId])
  @@index([shopId, date])
  @@index([shopId, channel, date])
}

// ---------------------------------------------------------------------------
// Fulfillment
// ---------------------------------------------------------------------------

model Fulfillment {
  id      String @id @default(cuid())
  shopId  String
  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status       String    @default("pending")
  createdAt    DateTime
  shippedAt    DateTime?
  deliveredAt  DateTime?
  carrier      String?
  serviceLevel String?

  shippingCost Decimal @db.Decimal(12, 2) @default(0)
  pickPackCost Decimal @db.Decimal(12, 2) @default(0)
  itemCount    Int     @default(0)
  location     String  @default("primary")

  @@index([shopId, createdAt])
  @@index([orderId])
}

/// Daily warehouse throughput. Backlog and capacity alerts are derived from
/// observed fulfilment rate, not from a number the merchant typed in once.
model CapacityDay {
  id       String   @id @default(cuid())
  shopId   String
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  location String   @default("primary")

  ordersReceived   Int     @default(0)
  ordersFulfilled  Int     @default(0)
  unitsFulfilled   Int     @default(0)
  backlogEnd       Int     @default(0)
  staffedHours     Decimal @db.Decimal(8, 2) @default(0)
  maxDailyCapacity Int     @default(0)

  @@unique([shopId, date, location])
  @@index([shopId, date])
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

model CostRule {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  kind  CostRuleKind
  label String

  /// Effective cost = percentRate * revenue
  ///                + fixedPerOrder
  ///                + fixedPerItem * units
  ///                + monthlyAmount amortised across that month's orders
  percentRate   Decimal? @db.Decimal(8, 5)
  fixedPerOrder Decimal? @db.Decimal(12, 4)
  fixedPerItem  Decimal? @db.Decimal(12, 4)
  monthlyAmount Decimal? @db.Decimal(12, 2)

  appliesToChannel Channel?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shopId, kind, active])
}

model Connector {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  provider ConnectorProvider
  status   ConnectorStatus   @default(NOT_CONFIGURED)

  externalAccountId String?
  displayName       String?

  /// AES-256-GCM ciphertext. See app/lib/crypto.server.ts — never plaintext.
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?

  lastSyncedAt DateTime?
  lastError    String?

  @@unique([shopId, provider])
}

model PricingRecommendation {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  currentPrice   Decimal @db.Decimal(12, 2)
  suggestedPrice Decimal @db.Decimal(12, 2)

  expectedUnitsDeltaPct Decimal @db.Decimal(8, 4) @default(0)
  expectedProfitDelta   Decimal @db.Decimal(12, 2) @default(0)

  elasticity Decimal?   @db.Decimal(8, 4)
  confidence Confidence @default(LOW)
  method     String
  rationale  String     @db.Text

  status      RecStatus @default(PENDING)
  generatedAt DateTime  @default(now())
  actionedAt  DateTime?

  @@index([shopId, status, generatedAt])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Channel {
  FACEBOOK
  GOOGLE
  TIKTOK
  EMAIL
  ORGANIC_SEARCH
  DIRECT
  REFERRAL
  AFFILIATE
  OTHER
}

enum CostSource {
  SHOPIFY
  MANUAL
  ESTIMATED
}

enum CostRuleKind {
  PAYMENT_FEE
  SHIPPING_DEFAULT
  PICK_PACK
  OVERHEAD_MONTHLY
  CUSTOM
}

enum ConnectorProvider {
  SHOPIFY
  FACEBOOK_ADS
  GOOGLE_ADS
  TIKTOK_ADS
  STRIPE
  WAREHOUSE_3PL
}

enum ConnectorStatus {
  NOT_CONFIGURED
  CONNECTED
  DISCONNECTED
  ERROR
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum RecStatus {
  PENDING
  APPLIED
  DISMISSED
}
