# --- required -------------------------------------------------------------

DATABASE_URL="postgresql://USER@localhost:5432/meridian?schema=public"

# Encrypts third-party OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
MERIDIAN_ENCRYPTION_KEY=""

# --- Shopify ---------------------------------------------------------------
#
# `npm run shopify:dev` injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET,
# SHOPIFY_APP_URL and SCOPES automatically from the linked app — you do NOT
# need to fill these in for local development with the CLI.
#
# Set them explicitly only when running without the CLI: a deployed instance,
# or `npm run dev` against a tunnel you manage yourself.

SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="http://localhost:3000"
SCOPES="read_orders,read_products,read_customers,read_fulfillments,read_inventory,read_reports,read_analytics"

# --- demo fallback ---------------------------------------------------------
#
# Serves the seeded demo store to genuinely unauthenticated visitors. Any
# request carrying a Shopify signal — shop/host/embedded/id_token params, or an
# App Bridge bearer token — goes through real authentication instead.
#
# The app refuses to boot if this is true while NODE_ENV=production.
MERIDIAN_DEMO_MODE="false"

# Safety valve for the historical import on very large stores.
# MERIDIAN_MAX_BACKFILL_ORDERS="20000"

NODE_ENV="development"
PORT="3000"
