# --- required -------------------------------------------------------------

DATABASE_URL="postgresql://USER@localhost:5432/meridian?schema=public"
# Merchant HTTP requests use a separate least-privileged PostgreSQL LOGIN that
# has only meridian_tenant. Never point this at the migration/worker owner.
# See docs/DATABASE_SECURITY.md for the one-time role provisioning commands.
MERIDIAN_TENANT_DATABASE_URL="postgresql://meridian-app-tenant@localhost:5432/meridian?schema=public"
# Production migrations need Fly MPG's direct session endpoint. Runtime keeps
# DATABASE_URL on the pooled endpoint; fly.toml swaps this value only for
# `prisma migrate deploy`.
DIRECT_DATABASE_URL="postgresql://USER@localhost:5432/meridian?schema=public"

# Encrypts third-party OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
MERIDIAN_ENCRYPTION_KEY=""
MERIDIAN_SHOPIFY_BRIDGE_SESSION_KEY=""

# Keys the shop-scoped customer-erasure guards that prevent delayed webhooks
# and historical imports from recreating an erased shopper. Generate once with
# `openssl rand -base64 32` and retain it for the lifetime of the deployment;
# rotating the connector-token encryption key must not rotate this key.
MERIDIAN_CUSTOMER_ERASURE_KEY=""

# Base64-encoded 32-byte HMAC key for privacy-safe distributed rate limits.
# Generate once with `openssl rand -base64 32` and keep it server-side.
MERIDIAN_RATE_LIMIT_KEY="replace_me"

# --- publisher operator dashboard -----------------------------------------
#
# /operator is not a merchant admin route. It uses a dedicated password,
# mandatory TOTP MFA and an isolated Strict cookie. Generate all four values
# once with `npm run operator:provision -- publisher@example.com`, enroll the
# returned otpauth URI, and keep the output in the production secret vault.
# Production readiness fails closed when any value is absent or malformed.
MERIDIAN_OPERATOR_EMAIL="replace_me"
MERIDIAN_OPERATOR_PASSWORD_HASH="replace_me"
MERIDIAN_OPERATOR_TOTP_SECRET="replace_me"
MERIDIAN_OPERATOR_SESSION_KEY="replace_me"

# Transactional email for waitlist confirmations, password resets, scheduled
# reports and alerts. Verify the sending domain with Resend and prove a
# controlled delivery before production deployment. This must be the verified
# MyMeridian sender, not a personal mailbox.
RESEND_API_KEY=""
MERIDIAN_EMAIL_FROM="MyMeridian <welcome@mymeridian.io>"
# Absolute public origin used only for email-safe links and logo URLs.
MERIDIAN_PUBLIC_ORIGIN="https://mymeridian.io"
# HMAC key for recipient-specific, no-expiry newsletter unsubscribe links.
# Generate once with `openssl rand -base64 32`; it is distinct from rate-limit
# and encryption keys so one purpose cannot mint another's tokens.
MERIDIAN_WAITLIST_UNSUBSCRIBE_KEY="replace_me"

# Mandatory standalone-account SMS MFA through Twilio Verify. Use a restricted
# production API key; never a Twilio account auth token.
TWILIO_ACCOUNT_SID="replace_me"
TWILIO_API_KEY_SID="replace_me"
TWILIO_API_KEY_SECRET="replace_me"
TWILIO_VERIFY_SERVICE_SID="replace_me"

# --- Shopify ---------------------------------------------------------------
#
# `npm run shopify:dev` injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET,
# SHOPIFY_APP_URL and SCOPES automatically from the linked app — you do NOT
# need to fill these in for local development with the CLI.
#
# Set them explicitly only when running without the CLI: a deployed instance,
# or `npm run dev` against a tunnel you manage yourself.

SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="http://localhost:3000"
# Must contain the same approved set as [access_scopes] in shopify.app.toml.
# Commas or spaces are both accepted. It is not just passed
# to shopifyApp() — capabilitiesForShop() falls back to it when a shop has no
# recorded grantedScopes, so listing a scope here that the store never granted
# makes the app claim data access it does not have (this previously advertised
# read_customers and read_analytics, neither of which is requested. `read_reports`
# is requested for Shopify Shipping label costs and Shop Campaigns reports, but
# ShopifyQL also requires a separate Level 2 protected-customer-data approval.
SCOPES="read_orders,read_products,read_fulfillments,read_inventory,read_reports"

# Provider-level credentials used to validate or refresh merchant ad tokens.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Google uses the MERIDIAN_GOOGLE_ADS_* variables in the ingestion section.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Production fly.toml sets this to true: /readyz then requires the Meta,
# Google Ads and TikTok credentials listed here and below. Leave it unset for
# staging while an external provider has not completed its review.
MERIDIAN_REQUIRE_LAUNCH_CONNECTORS="false"

# Standalone MyMeridian account sign-in. Register these callbacks on the
# canonical production origin only; do not expose either client secret to the
# browser. Apple private keys are stored with literal newlines escaped as `\\n`
# in the deployment secret store.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register as a Microsoft Entra web application. `common` accepts both work /
# school and personal Microsoft accounts; set a specific directory tenant to
# limit sign-in to that organization.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Connector alerts fall back to the verified MERIDIAN_SUPPORT_EMAIL through
# Resend. A signed HTTPS webhook may be configured instead when an external
# incident receiver is available. Confirmed authorization disconnects alert
# immediately; other provider failures alert after 3 consecutive checks.
CONNECTOR_ALERT_WEBHOOK_URL=
CONNECTOR_ALERT_WEBHOOK_SECRET=

# One-use operator input for `npm run connector:configure`; never commit a real
# value. The script encrypts it before persistence and never prints it.
MERIDIAN_CONNECTOR_TOKEN=
MERIDIAN_CONNECTOR_REFRESH_TOKEN=

# --- demo fallback ---------------------------------------------------------
#
# Serves the seeded demo store to genuinely unauthenticated visitors. Any
# request carrying a Shopify signal — shop/host/embedded/id_token params, or an
# App Bridge bearer token — goes through real authentication instead.
#
# The app refuses to boot if this is true while NODE_ENV=production.
MERIDIAN_DEMO_MODE="false"

# Optional local diagnostic safety valve. Production has no implicit order
# ceiling; reaching an explicit limit pauses visibly and preserves its cursor.
# MERIDIAN_MAX_BACKFILL_ORDERS="20000"

# Ceiling on what the analytics caches retain, counted in per-order profit rows
# across every cached window and shop. Roughly 520 bytes a row, so the 120,000
# default is ~60MB against the 1024MB VM in fly.toml. Raise it on a larger box;
# it buys cache hits, not correctness — every entry expires after 60s anyway.
# MERIDIAN_ANALYTICS_CACHE_ORDERS="120000"

NODE_ENV="development"
PORT="3000"

# --- ad-spend ingestion (BullMQ / Redis) -----------------------------------
#
# Continuous Meta/Google/TikTok/Shop Campaigns spend polling. Staging may run
# without Redis while a provider remains unavailable; production requires it
# before it will declare ready, because launch connectors must ingest and
# recover durably. With it, the web process (and/or `npx tsx scripts/ads-worker.ts`) starts per-source
# ingestion queues, a scheduler that re-plans every connector from the
# AdSyncWindow ledger each cycle — which is what makes dropped syncs
# self-healing — and a debounced profit recompute.
MERIDIAN_REDIS_URL="redis://localhost:6379"

# Set true to keep queues out of a process (e.g. a web process in a split
# web/worker deployment where only the worker should poll).
# MERIDIAN_ADS_WORKER_DISABLED="false"
# Production fly.toml requires launch connectors and therefore rejects a
# deployment with this set to true. Do not turn it on as a quota workaround in
# production; recover Redis capacity or pause the affected provider instead.

# Polling cadence and restatement windows. Defaults shown. Platforms restate
# recent days as attribution windows close, so the last LOOKBACK days are
# re-polled every cycle and a deep pass re-polls DEEP_LOOKBACK days every
# DEEP_CADENCE days.
# MERIDIAN_ADS_POLL_MINUTES="30"
# MERIDIAN_ADS_LOOKBACK_DAYS="3"
# MERIDIAN_ADS_DEEP_LOOKBACK_DAYS="28"
# MERIDIAN_ADS_DEEP_CADENCE_DAYS="7"
# MERIDIAN_ADS_INITIAL_BACKFILL_DAYS="90"

# Google Ads API credentials (the other platforms need only the per-connector
# OAuth token stored encrypted on the Connector row).
MERIDIAN_GOOGLE_ADS_CLIENT_ID=""
MERIDIAN_GOOGLE_ADS_CLIENT_SECRET=""
MERIDIAN_GOOGLE_ADS_DEVELOPER_TOKEN=""

# Foreign-currency ad accounts convert to the shop currency through a daily
# FX table fed by api.frankfurter.app (cached in Postgres; conversions reuse
# the stored day rate forever). Set true to forbid the network fetch — spend
# in an unpinned currency then fails visibly instead of converting.
# MERIDIAN_FX_DISABLED="false"

# --- listing / support -----------------------------------------------------
#
# Shopify's listing requires a reachable support contact and a public privacy
# policy. Use the verified support mailbox only in environment-specific
# configuration; the legal entity remains a separate owner-supplied value.
MERIDIAN_SUPPORT_EMAIL=""
MERIDIAN_LEGAL_ENTITY=""
# Optional: help centre or contact form, shown alongside the email.
MERIDIAN_SUPPORT_URL=""

# --- revenue MCP: cash side ------------------------------------------------
#
# scripts/revenue-mcp.ts reads Meridian's own database for the subscription
# side with no extra config. Its cash_summary tool (gross charged, Shopify's
# fee, net to us — the Partner API transaction ledger) additionally needs a
# Partner API client: partners.shopify.com -> Settings -> Partner API clients,
# read-only "View financials" scope. Org ID is the number in the dashboard URL.
SHOPIFY_PARTNER_ORG_ID=""
SHOPIFY_PARTNER_API_TOKEN=""
